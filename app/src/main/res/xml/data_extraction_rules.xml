<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Nothing is backed up. Conversations are private to the device by design,
        and model weights are gigabytes that can always be downloaded again.
    -->
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
